#include <windows.h>

1 ICON "res/app.ico"
1 24 "setup/setup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "YouTube to PC"
            VALUE "FileDescription", "YouTube to PC Setup"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "YouTubeToPC-Setup"
            VALUE "OriginalFilename", "YouTubeToPC-Setup.exe"
            VALUE "ProductName", "YouTube to PC"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
